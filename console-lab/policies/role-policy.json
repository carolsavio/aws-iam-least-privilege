{
	"Version": "2012-10-17",
	"Statement": [
		{
			"Sid": "ListBucket",
			"Effect": "Allow",
			"Action": "s3:ListBucket",
			"Resource": "arn:aws:s3:::my-lab-bucket",
			"Condition": {
				"StringLike": {
					"s3:prefix": [
						"data/processed/*",
						"data/uploads/*"
					]
				}
			}
		},
		{
			"Sid": "ReadWriteObjects",
			"Effect": "Allow",
			"Action": [
				"s3:GetObject",
				"s3:PutObject"
			],
			"Resource": [
				"arn:aws:s3:::my-lab-bucket/data/processed/*",
				"arn:aws:s3:::my-lab-bucket/data/uploads/*"
			]
		}
	]
}
